# Ethereum TPS Workload Configuration
# Copy this to .env and configure

# RPC Configuration
# RPC_URL=http://localhost:8545
RPC_URL=http://geth-node.local:80

# Metrics Server Configuration
METRICS_HOST=localhost
METRICS_PORT=9000
METRICS_WINDOW_PERIOD=40
BLOCK_POLL_INTERVAL=1.0

# Default CLI Mode Settings
DEFAULT_GAS=21000
DEFAULT_TX_VALUE=0.01
DEFAULT_CONCURRENCY=5
DEFAULT_TPS=5
DEFAULT_DURATION=30

# Incremental Transaction Value Configuration (CLI mode)
USE_INCREMENTAL_VALUE=true
TX_VALUE_MIN=0.001
TX_VALUE_MAX=0.01
TX_VALUE_INCREMENT=0.001
TX_VALUE_MODE=ascending

# Server Mode Configuration
SERVER_NUM_ACCOUNTS=10
SERVER_FUND_AMOUNT=10000
SERVER_TX_MIN=0.1
SERVER_TX_MAX=5
SERVER_TX_INCREMENT=0.5
SERVER_TX_MODE=ascending
SERVER_LOAD_MODE=random
SERVER_TPS=5
SERVER_DURATION=10
SERVER_GAS=21000

# Keystore Configuration
UTC_FILE_PATH=
UTC_PASSWORD=
UTC_SEARCH_PATHS=
